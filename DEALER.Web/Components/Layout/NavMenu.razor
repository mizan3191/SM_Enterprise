    @if (showBackupModal)
    {
        <div class="modal-backdrop-custom" @onclick="CloseBackupModal"></div>
        <div class="modal-custom">
            <div class="modal-content-custom">
                <h5>Database Backup</h5>
                <p>আপনি কি ডাটাবেস ব্যাকআপ ডাউনলোড করতে চান?</p>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2">@errorMessage</div>
                }

                <div class="modal-actions">
                    <button class="btn btn-secondary" @onclick="CloseBackupModal" disabled="@isDownloading">
                        Cancel
                    </button>
                    <button class="btn btn-primary" @onclick="ConfirmBackup" disabled="@isDownloading">
                        @if (isDownloading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Downloading...</span>
                        }
                        else
                        {
                            <span>Yes, Download</span>
                        }
                    </button>
                </div>
            </div>
        </div>
