@code {

    //[Inject]
    // private ICompany m_Company { get; set; }

    private CompanyInfo CompanyInfo { get; set; }

    private bool showBackupModal = false;
    private bool isDownloading = false;
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        CompanyInfo = m_Company.GetCompanyInfo();
    }

    private void OpenBackupModal()
    {
        errorMessage = string.Empty;
        showBackupModal = true;
    }

    private void CloseBackupModal()
    {
        if (isDownloading) return; // downloading অবস্থায় close করতে দিবো না
        showBackupModal = false;
        errorMessage = string.Empty;
    }

    private async Task ConfirmBackup()
    {
        isDownloading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var zipBytes = await m_Company.CreateBackupZipAsync();
            var fileName = $"database_backup_{DateTime.Now:yyyyMMdd_HHmmss}.zip";
            await JS.InvokeVoidAsync("saveAsFile", fileName, Convert.ToBase64String(zipBytes));
            showBackupModal = false;
        }
        catch (Exception ex)
        {
            errorMessage = "ব্যাকআপ তৈরি করতে সমস্যা হয়েছে। আবার চেষ্টা করুন।";
        }
        finally
        {
            isDownloading = false;
            StateHasChanged();
        }
    }


    private Dictionary<string, bool> sectionStates = new()
    {
        { "sales", false },
        { "purchases", false },
        { "products", false },
        { "damageProduct", false },
        { "history", false },
        { "due", false },
        { "expenses", false },
        { "lookup", false },
        { "admin", false }
    };

    private void ToggleSection(string sectionName)
    {
        sectionStates[sectionName] = !sectionStates[sectionName];
    }

    private bool IsSectionOpen(string sectionName)
    {
        return sectionStates.TryGetValue(sectionName, out var isOpen) && isOpen;
    }

    private string GetToggleIcon(string sectionName)
    {
        return IsSectionOpen(sectionName) ? "▼" : "►";
    }
}