@page "/DealerPointDueSummary"
@using DEALER.Domain

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<Message @ref="notificationComponent" />
<h3>Dealer Point Due Summary</h3>

<div class="card-body p-0">
    <div class="d-flex align-items-center justify-content-between mb-3" style="width: 100%;">
        <div class="d-flex align-items-center border rounded" style="width: fit-content;">
            <span class="ps-2" style="font-size: 1.2rem; color: #6c757d;">
                <i class="fas fa-search"></i>
            </span>
            <RadzenTextBox @bind-Value="@search" TValue="string" Placeholder="Search..."
                           @oninput="OnSearch"
                           Style="border: none; box-shadow: none; padding-left: 0.5rem;" />
        </div>

        <div class="d-flex align-items-center" style="gap: 0.5rem;">
            <RadzenButton Text="Export To PDF" Icon="picture_as_pdf"
                          Click="@(args => ExportToPdf())" />
            <RadzenButton Text="Add Payment" Icon="add"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="OpenPaymentModal" />
        </div>
    </div>


    <RadzenDataGrid Data="@FilteredDealerPoints" TItem="DealerPointDueDTO"
                    PageSize="10" AllowPaging="true" AllowSorting="true">
        <Columns>
            <RadzenDataGridColumn TItem="DealerPointDueDTO" Property="@nameof(DealerPointDueDTO.Name)" Title="Dealer" Width="220px">
                <Template Context="item">
                    <div class="fw-bold"
                         style="border-left: 4px solid @(item.NetDue > 0 ? "#198754" : item.NetDue < 0 ? "#dc3545" : "#adb5bd");
                        padding-left: 8px;">
                        @item.Name
                    </div>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="DealerPointDueDTO" Property="@nameof(DealerPointDueDTO.Phone)"
                                  Title="Phone" Width="150px" />
            <RadzenDataGridColumn TItem="DealerPointDueDTO" Property="@nameof(DealerPointDueDTO.Address)"
                                  Title="Address" Width="250px" />

            <RadzenDataGridColumn TItem="DealerPointDueDTO" Title="Balance" TextAlign="TextAlign.Right" Width="170px">
                <Template Context="item">
                    <span class="badge fs-6 @(item.NetDue > 0 ? "bg-success" : item.NetDue < 0 ? "bg-danger" : "bg-secondary")">
                        @Math.Abs(item.NetDue).ToString("N2")
                    </span>
                </Template>
                <FooterTemplate>
                    <div class="text-end fw-bold">
                        @Math.Abs(FilteredDealerPoints.Sum(o => o.NetDue)).ToString("N2")
                    </div>
                </FooterTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="DealerPointDueDTO" Property="@nameof(DealerPointDueDTO.StatusText)"
                                  Title="Status" Width="180px">
                <Template Context="item">
                    @if (item.NetDue > 0)
                    {
                        <span class="badge bg-success">
                            <i class="fas fa-hand-holding-usd me-1"></i> Receivable
                        </span>
                    }
                    else if (item.NetDue < 0)
                    {
                        <span class="badge bg-danger">
                            <i class="fas fa-hand-holding-usd me-1"></i> Payable
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">-</span>
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="DealerPointDueDTO" Title="Actions" Width="80px">
                <Template Context="dealer">
                    <RadzenButton Icon="payment" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                                  Click="() => OpenPaymentForDealer(dealer.Id)" title="Payment" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</div>

@* ================= PAYMENT MODAL ================= *@
@if (showPaymentModal)
{
    <div class="modal" data-bs-backdrop="static" data-bs-keyboard="false"
         tabindex="1" style="display:block">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content card dataFormPop">
                <div class="modal-header">
                    <h3>Dealer Payment</h3>
                </div>
                <div class="row m-3">
                    <div class="col-12 mb-3">
                        <label class="form-label">Dealer</label>
                        <RadzenDropDown TValue="int?"
                                        @bind-Value="SelectedDealerId"
                                        Data="@DealerList"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        Placeholder="Select Dealer"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Change="OnDealerChanged"
                                        Class="w-100" />
                    </div>

                    @if (SelectedDealer != null)
                    {
                        <div class="col-12 mb-3">
                            @if (SelectedDealer.NetDue > 0)
                            {
                                <div class="alert alert-primary mb-0">
                                    <strong>@SelectedDealer.Name</strong> has to pay us:
                                    <strong>@SelectedDealer.NetDue.ToString("N2")</strong>
                                </div>
                            }
                            else if (SelectedDealer.NetDue < 0)
                            {
                                <div class="alert alert-danger mb-0">
                                    We have to pay <strong>@SelectedDealer.Name</strong>:
                                    <strong>@Math.Abs(SelectedDealer.NetDue).ToString("N2")</strong>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">No outstanding balance.</div>
                            }
                        </div>
                    }

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Amount</label>
                        <input type="number" step="0.01" min="0"
                               class="form-control text-end"
                               value="@NewPayment.Amount"
                               @oninput="OnAmountInput" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date</label>
                        <RadzenDatePicker @bind-Value="NewPayment.Date"
                                          DateFormat="yyyy-MM-dd" Class="w-100" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Type</label>
                        <RadzenDropDown TValue="string"
                                        @bind-Value="NewPayment.Direction"
                                        Data="@DirectionOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Disabled="true"
                                        Class="w-100" />
                        <small class="text-muted">Auto set from dealer balance.</small>

                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Payment Method</label>
                        <RadzenDropDown TValue="int?"
                                        @bind-Value="NewPayment.PaymentMethodId"
                                        Data="@PaymentMethods"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        Placeholder="Select Payment Method"
                                        AllowClear="true"
                                        Class="w-100" />
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">Comments</label>
                        <input type="text" class="form-control"
                               @bind="NewPayment.Comments"
                               placeholder="Optional remarks" />
                    </div>

                    <div class="col-12">
                        <RadzenButton Text="Save" Icon="save"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="SavePayment" Class="m-2" />
                        <RadzenButton Text="Cancel" Icon="cancel"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="ClosePaymentModal" Class="m-2" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private ICylinderExchange m_CylinderExchange { get; set; }
    [Inject] private ILookup m_Lookup { get; set; }
    [Inject] private IJSRuntime JSRuntime { get; set; }

    private Message notificationComponent;

    private IEnumerable<DealerPointDueDTO> DealerPointDueHistory { get; set; } = new List<DealerPointDueDTO>();
    private IEnumerable<DealerPointDueDTO> FilteredDealerPoints { get; set; } = new List<DealerPointDueDTO>();
    private IEnumerable<Lov> DealerList { get; set; } = new List<Lov>();
    private IEnumerable<Lov> PaymentMethods { get; set; } = new List<Lov>();
    private string search = string.Empty;

    private bool showPaymentModal;
    private int? SelectedDealerId { get; set; }
    private ExchangePaymentHistory NewPayment { get; set; } = new();

    private readonly List<DropdownItem> DirectionOptions = new()
    {
        new DropdownItem { Text = "Receive (We Take Money)", Value = "Receive" },
        new DropdownItem { Text = "Give (We Pay Money)",    Value = "Give" }
    };

    private DealerPointDueDTO SelectedDealer =>
        DealerPointDueHistory.FirstOrDefault(x => x.Id == SelectedDealerId);

    protected override async Task OnInitializedAsync()
    {
        DealerList = m_CylinderExchange.GetDealerPointList();
        PaymentMethods = await m_Lookup.GetAllPaymentMethodList();
        LoadSummary();
    }

    private void LoadSummary()
    {
        DealerPointDueHistory = m_CylinderExchange.GetDealerPointDueSummary();
        FilterData();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;
        FilterData();
    }

    private void FilterData()
    {
        var list = DealerPointDueHistory.Where(d => d.NetDue != 0);

        if (!string.IsNullOrWhiteSpace(search))
        {
            list = list.Where(d =>
                (!string.IsNullOrEmpty(d.Name) && d.Name.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(d.Address) && d.Address.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(d.Phone) && d.Phone.Contains(search, StringComparison.OrdinalIgnoreCase)));
        }

        FilteredDealerPoints = list.ToList();
    }

    private void OpenPaymentModal()
    {
        SelectedDealerId = null;
        NewPayment = new ExchangePaymentHistory
        {
            Date = DateTime.Now,
            Direction = "Receive"
        };
        showPaymentModal = true;
    }

    private void OpenPaymentForDealer(int dealerId)
    {
        OpenPaymentModal();
        SelectedDealerId = dealerId;
        NewPayment.Direction = SelectedDealer?.NetDue < 0 ? "Give" : "Receive";
    }

    private void ClosePaymentModal() => showPaymentModal = false;

    private void OnDealerChanged(object value)
    {
        if (value == null)
        {
            SelectedDealerId = null;
            return;
        }

        if (int.TryParse(value.ToString(), out var id))
        {
            SelectedDealerId = id;
            // Balance onujayi default direction set
            NewPayment.Direction = SelectedDealer?.NetDue < 0 ? "Give" : "Receive";
        }
    }

    private void OnAmountInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double v))
            NewPayment.Amount = v < 0 ? 0 : v;
    }

    private async Task SavePayment()
    {
        if (SelectedDealerId == null)
        {
            notificationComponent.Show("Validation Error",
                "Please select a dealer.", NotificationSeverity.Warning);
            return;
        }

        if (NewPayment.Amount <= 0)
        {
            notificationComponent.Show("Validation Error",
                "Amount must be greater than zero.", NotificationSeverity.Warning);
            return;
        }

        if (NewPayment.PaymentMethodId == null || NewPayment.PaymentMethodId <= 0)
        {
            notificationComponent.Show("Validation Error",
                "Please select a Payment Method.", NotificationSeverity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(NewPayment.Direction))
        {
            notificationComponent.Show("Validation Error",
                "Please select payment type.", NotificationSeverity.Warning);
            return;
        }

        try
        {
            NewPayment.DealerPointId = SelectedDealerId;
            m_CylinderExchange.AddDealerPointPayment(NewPayment);

            notificationComponent.Show("Added",
                "Dealer payment has been saved successfully.", NotificationSeverity.Success);

            showPaymentModal = false;
            LoadSummary();
        }
        catch (Exception ex)
        {
            notificationComponent.Show("Error", ex.Message, NotificationSeverity.Error);
        }
    }

    public async Task ExportToPdf()
    {
        if (!ValidationHelper.ValidateAndNotify(FilteredDealerPoints, notificationComponent))
            return;

        var document = Document.Create(container =>
        {
            container.Page(page =>
            {
                page.MarginTop(20);
                page.MarginBottom(20);
                page.MarginLeft(40);
                page.MarginRight(40);
                page.Size(PageSizes.A4);
                page.DefaultTextStyle(style => style.FontSize(10));

                page.Header().Element(ComposeHeader);

                page.Content()
                    .PaddingVertical(10)
                    .Table(table =>
                    {
                        table.ColumnsDefinition(columns =>
                        {
                            columns.RelativeColumn(3);
                            columns.RelativeColumn(2);
                            columns.RelativeColumn(4);
                            columns.RelativeColumn(2);
                            columns.RelativeColumn(2);
                        });

                        table.Header(header =>
                        {
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Dealer").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Phone").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Address").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Balance").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Status").Bold();
                        });

                        foreach (var dealer in FilteredDealerPoints)
                        {
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text(dealer.Name);
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text(dealer.Phone);
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text(dealer.Address);
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text($"{Math.Abs(dealer.NetDue):N2}");
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text(dealer.StatusText);
                        }
                    });

                page.Footer().Row(row =>
                {
                    row.RelativeItem().AlignLeft().Text(DateTime.Now.ToString("dd/MM/yyyy HH:mm"));
                    row.RelativeItem().AlignCenter().Text(text =>
                    {
                        text.CurrentPageNumber();
                        text.Span(" / ");
                        text.TotalPages();
                    });
                    row.RelativeItem();
                });
            });
        });

        using var stream = new MemoryStream();
        document.GeneratePdf(stream);

        var fileName = $"DealerPointDues_{DateTime.Now:yyyyMMddHHmmss}.pdf";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, "application/pdf", stream.ToArray());
    }

    void ComposeHeader(IContainer container)
    {
        var company = m_Lookup.GetCompanyInfo();

        container.Row(row =>
        {
            row.RelativeItem().Column(column =>
            {
                column.Item().AlignCenter().Text($"{company.CompanyName}").Bold().FontSize(16);
                column.Item().AlignCenter().Text($"{company.Address}").FontSize(10);
                column.Item().AlignCenter().Text($"Dealer Point Dues Report").Bold().FontSize(10);
            });
        });
    }
}