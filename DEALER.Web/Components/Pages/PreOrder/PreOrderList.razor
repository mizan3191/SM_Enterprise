@page "/PreOrderList"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject DialogService DialogService

<Message @ref="notificationComponent" />

<h3>Pre Orders</h3>

@if (PreOrders == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card-body p-0">
        <div class="d-flex align-items-center mb-3" style="width: 100%;">
            <RadzenButton Click="@AddNew" Text="Add New" ButtonStyle="ButtonStyle.Success" />

            <!-- Search Box -->
            <div class="d-flex align-items-center border rounded me-3 mx-3" style="width: fit-content;">
                <span class="ps-2" style="font-size: 1.2rem; color: #6c757d;">
                    <i class="fas fa-search"></i>
                </span>
                <RadzenTextBox @bind-Value="@search" TValue="string" Placeholder="Search..." @oninput="OnSearch"
                               Style="border: none; box-shadow: none; padding-left: 0.5rem;" />
            </div>

            <!-- Export Button -->
            <div class="d-flex align-items-center border rounded" style="width: fit-content;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem;" Wrap="FlexWrap.Wrap" Style="padding-left: 0.10rem;">
                    <RadzenButton Text="Export To PDF" Icon="picture_as_pdf" Click="@(args => ExportToPdf())" />
                </RadzenStack>
            </div>
        </div>

        <RadzenDataGrid Data="@FilteredPreOrders" TItem="PreOrder" PageSize="10" AllowPaging="true" AllowSorting="true" AllowFiltering="false">
            <Columns>
                <RadzenDataGridColumn TItem="PreOrder" Property="@nameof(PreOrder.OrderNumber)" Title="Order No" Width="110px" />
                <RadzenDataGridColumn TItem="PreOrder" Title="Supplier" Width="140px">
                    <Template Context="item">
                        <div>@item.Supplier?.Name</div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Property="@nameof(PreOrder.OrderDate)" Title="Order Date" Width="110px">
                    <Template Context="item">
                        <div>@item.OrderDate.ToString("dd-MMM-yyyy")</div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Property="@nameof(PreOrder.ExpectedDeliveryDate)" Title="Expected" Width="110px">
                    <Template Context="item">
                        @if (item.ExpectedDeliveryDate.HasValue)
                        {
                            <div class="@(IsOverdue(item) ? "text-danger fw-bold" : "")">@item.ExpectedDeliveryDate.Value.ToString("dd-MMM-yyyy")</div>
                        }
                        else
                        {
                            <div class="text-muted">-</div>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Title="Ordered" Width="80px" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        <div>@item.PreOrderDetails.Sum(d => d.OrderedQuantity)</div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Title="Delivered" Width="80px" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        <div>@item.PreOrderDetails.Sum(d => d.DeliveredQuantity)</div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Title="Pending" Width="80px" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        <div class="fw-bold">@item.PreOrderDetails.Sum(d => d.PendingQuantity)</div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Title="Total Amount" Width="110px" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        <div>@item.TotalAmount.ToString("N2")</div>
                    </Template>
                    <FooterTemplate>
                        <div class="text-end fw-bold">@FilteredPreOrders.Sum(o => o.TotalAmount).ToString("N2")</div>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Title="Paid" Width="110px" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        <div>@item.TotalPaid.ToString("N2")</div>
                    </Template>
                    <FooterTemplate>
                        <div class="text-end fw-bold">@FilteredPreOrders.Sum(o => o.TotalPaid).ToString("N2")</div>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Title="Due" Width="110px" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        <div class="@(item.TotalDue < 0 ? "text-success" : "")">@item.TotalDue.ToString("N2")</div>
                    </Template>
                    <FooterTemplate>
                        <div class="text-end fw-bold">@FilteredPreOrders.Sum(o => o.TotalDue).ToString("N2")</div>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Title="Status" Width="130px">
                    <Template Context="item">
                        <span class="badge @StatusClass(item.Status)">@StatusText(item.Status)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PreOrder" Title="Actions" Width="130px">
                    <Template Context="context">
                        <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                      Click="() => Details(context.Id)" style="margin-right: 5px;" title="Details / Payment / Delivery" />

                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                      Click="() => Edit(context.Id)" style="margin-right: 5px;" title="Edit" />

                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                      Click="() => Delete(context.Id)" title="Delete" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}

@code {
    [Inject]
    private IPreOrder m_PreOrder { get; set; }

    [Inject]
    private ILookup m_Lookup { get; set; }

    [Inject]
    private NavigationManager _navigationManager { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    private Message notificationComponent;

    public IEnumerable<PreOrder> PreOrders { get; set; }
    private IEnumerable<PreOrder> FilteredPreOrders { get; set; } = new List<PreOrder>();

    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        PreOrders = await m_PreOrder.GetAllPreOrders();
        FilterData();
    }

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    private static string StatusClass(PreOrderStatus status) => status switch
    {
        PreOrderStatus.Pending => "bg-secondary",
        PreOrderStatus.PartiallyDelivered => "bg-warning text-dark",
        PreOrderStatus.Delivered => "bg-success",
        PreOrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    private static string StatusText(PreOrderStatus status) => status switch
    {
        PreOrderStatus.PartiallyDelivered => "Partially Delivered",
        _ => status.ToString()
    };

    // পণ্য এখনো বাকি আছে কিন্তু expected তারিখ পেরিয়ে গেছে
    private static bool IsOverdue(PreOrder order) =>
        order.ExpectedDeliveryDate.HasValue
        && order.ExpectedDeliveryDate.Value.Date < DateTime.Today
        && (order.Status == PreOrderStatus.Pending || order.Status == PreOrderStatus.PartiallyDelivered);

    // ---------------------------------------------------------------
    // Navigation
    // ---------------------------------------------------------------
    private void AddNew() => _navigationManager.NavigateTo("/PreOrder");
    private void Edit(int id) => _navigationManager.NavigateTo($"/PreOrder/{id}");
    private void Details(int id) => _navigationManager.NavigateTo($"/PreOrderDetails/{id}");

    // ---------------------------------------------------------------
    // Delete
    // ---------------------------------------------------------------
    private async Task Delete(int id)
    {
        var confirm = await DialogService.Confirm(
            "Are you sure you want to delete this pre-order? All its payments will be reversed.",
            "Delete Pre Order",
            new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });

        if (confirm != true)
            return;

        try
        {
            m_PreOrder.DeletePreOrder(id);
            notificationComponent.Show("Deleted", "Pre-order has been deleted successfully.", NotificationSeverity.Success);
            await LoadData();
        }
        catch (Exception ex)
        {
            notificationComponent.Show("Error", ex.Message, NotificationSeverity.Error);
        }
    }

    // ---------------------------------------------------------------
    // Search
    // ---------------------------------------------------------------
    private void OnSearch(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;
        FilterData();
    }

    private void FilterData()
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            FilteredPreOrders = PreOrders;
        }
        else
        {
            FilteredPreOrders = PreOrders.Where(c =>
                (!string.IsNullOrEmpty(c.OrderNumber) && c.OrderNumber.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(c.Supplier?.Name) && c.Supplier.Name.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                StatusText(c.Status).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                c.TotalAmount.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    // ---------------------------------------------------------------
    // Export to PDF
    // ---------------------------------------------------------------
    public async Task ExportToPdf()
    {
        if (!ValidationHelper.ValidateAndNotify(FilteredPreOrders, notificationComponent))
            return;

        var document = Document.Create(container =>
        {
            container.Page(page =>
            {
                page.MarginTop(20);
                page.MarginBottom(20);
                page.MarginLeft(40);
                page.MarginRight(40);

                page.Size(PageSizes.A4);
                page.DefaultTextStyle(style => style.FontSize(10));

                page.Header().Element(ComposeHeader);

                page.Content()
                    .PaddingVertical(10)
                    .Table(table =>
                    {
                        table.ColumnsDefinition(columns =>
                        {
                            columns.RelativeColumn(2);
                            columns.RelativeColumn(3);
                            columns.RelativeColumn(2);
                            columns.RelativeColumn(2);
                            columns.RelativeColumn(2);
                            columns.RelativeColumn(2);
                            columns.RelativeColumn(2);
                        });

                        table.Header(header =>
                        {
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Order No").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Supplier").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Date").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Pending Qty").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Total").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Paid").Bold();
                            header.Cell().Background("#f5f5f5").Padding(5).Text("Due").Bold();
                        });

                        foreach (var order in FilteredPreOrders)
                        {
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text(order.OrderNumber);
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text(order.Supplier?.Name ?? "");
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text(order.OrderDate.ToString("dd-MMM-yyyy"));
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text(order.PreOrderDetails.Sum(d => d.PendingQuantity).ToString());
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text($"{order.TotalAmount:N2}");
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text($"{order.TotalPaid:N2}");
                            table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text($"{order.TotalDue:N2}");
                        }

                        table.Cell().ColumnSpan(4).PaddingVertical(5).PaddingHorizontal(5).AlignRight().Text("Total").Bold();
                        table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text($"{FilteredPreOrders.Sum(x => x.TotalAmount):N2}").Bold();
                        table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text($"{FilteredPreOrders.Sum(x => x.TotalPaid):N2}").Bold();
                        table.Cell().PaddingVertical(5).PaddingHorizontal(5).Text($"{FilteredPreOrders.Sum(x => x.TotalDue):N2}").Bold();
                    });

                page.Footer().Row(row =>
                {
                    row.RelativeItem().AlignLeft().Text(DateTime.Now.ToString("dd/MM/yyyy HH:mm"));
                    row.RelativeItem().AlignCenter().Text(text =>
                    {
                        text.CurrentPageNumber();
                        text.Span(" / ");
                        text.TotalPages();
                    });
                    row.RelativeItem();
                });
            });
        });

        using var stream = new MemoryStream();
        document.GeneratePdf(stream);

        var fileName = $"Pre Orders_{DateTime.Now:yyyyMMddHHmmss}.pdf";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, "application/pdf", stream.ToArray());
    }

    void ComposeHeader(IContainer container)
    {
        var company = m_Lookup.GetCompanyInfo();

        container.Row(row =>
        {
            row.RelativeItem().Column(column =>
            {
                column.Item().AlignCenter().Text($"{company.CompanyName}").Bold().FontSize(16);
                column.Item().AlignCenter().Text($"{company.Address}").FontSize(10);
                column.Item().AlignCenter().Text($"Pre Orders Report").Bold().FontSize(10);
            });
        });
    }
}
